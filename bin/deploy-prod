#!/bin/sh

set -xe

docker compose -f docker-compose.prod.yml build
docker compose -f docker-compose.prod.yml push
ssh barmbek@drk-barmbek.de mkdir -p einsatz
scp docker-compose.prod.yml barmbek@drk-barmbek.de:einsatz/
ssh -t barmbek@drk-barmbek.de "cd einsatz && docker compose -f docker-compose.prod.yml pull && docker compose -f docker-compose.prod.yml up -d --remove-orphans"
