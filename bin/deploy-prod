#!/usr/bin/env bash

set -euo pipefail

# Directory on the server; the Compose project name is set in compose.prod.yaml.
remote_dir=einsatz
host=barmbek@drk-barmbek.de

cd "$(dirname "$0")/.."

compose() {
  docker compose -f compose.prod.yaml "$@"
}

# Decrypted up front, so a missing key stops the deploy before the build.
# The plaintext only ever lives in this variable, never on local disk.
secrets=
if [[ -f secrets.prod.env ]]; then
  echo "==> Decrypting secrets..."
  secrets=$(sops -d secrets.prod.env)
fi

echo "==> Building images..."
compose build --pull

echo "==> Transferring images..."
compose config --images \
  | xargs docker save \
  | zstd -10 -T0 \
  | dd bs=1M status=progress \
  | ssh "$host" 'zstd -d | docker load'

echo "==> Copying compose file..."
ssh "$host" mkdir -p "$remote_dir"
scp compose.prod.yaml "$host:$remote_dir/compose.yaml"

if [[ -n $secrets ]]; then
  echo "==> Copying secrets..."
  # Written beside .env and renamed, so a dropped connection can't leave
  # a truncated .env behind. umask makes it readable by the owner only.
  printf '%s\n' "$secrets" \
    | ssh -T "$host" "cd $remote_dir && umask 077 && cat > .env.new && mv -f .env.new .env"
fi

echo "==> Starting containers..."
ssh -t "$host" "cd $remote_dir && docker compose up -d --remove-orphans --wait --wait-timeout 120"

echo "==> Removing unused images..."
ssh "$host" docker image prune -f

echo "==> Deployment complete."
