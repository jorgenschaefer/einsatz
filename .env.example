# PostgreSQL-Verbindung
DATABASE_URL=postgres://einsatz:einsatz@localhost:5436/einsatz

# Erst-Admin, nur beim ersten Start nötig (per Seed angelegt, solange es noch
# keine Nutzer gibt). Passwort: 12 Zeichen bis 72 Byte, nicht der Nutzername und
# keines der 10.000 häufigsten Passwörter.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Server-seitiger MapTiler-API-Key (OSM-Kacheln im Gratis-Kontingent). In
# Produktion Pflicht, ohne ihn startet die App nicht; in der Entwicklung
# lädt die Lagekarte ohne ihn die öffentlichen OSM-Kacheln.
MAPTILER_API_KEY=
